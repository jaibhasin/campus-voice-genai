# Required for final answers and Jev retrieval. Keep real keys in .env.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional voice features.
SARVAM_API_KEY=

# Jev owns retrieval by default. Use llm for an explicit baseline comparison.
RETRIEVAL_MODE=jev
JEV_MODEL=jev-1.13.0
JEV_MAX_ROUNDS=12
JEV_MAX_SECONDS=20
JEV_REQUEST_TIMEOUT=5

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tiet-chatbot
